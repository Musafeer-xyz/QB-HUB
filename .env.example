# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Used by the import script, the first-run setup route and the
# PDF/print token fallback. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Admin setup
# ---------------------------------------------------------------------------
# Secret required on /setup to create the first admin account.
SETUP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Data source: "supabase" (default when the two NEXT_PUBLIC_* vars are set)
# or "local" (development/demo mode reading ./data and writing ./local-data).
# DATA_SOURCE=supabase

# Secret used to sign the short-lived token the PDF renderer uses to open
# /print/[id]. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
# PRINT_TOKEN_SECRET=

# Path to a Chromium/Chrome binary for server-side PDF generation.
# On developer machines system Chrome/Edge is detected automatically;
# on Vercel @sparticuz/chromium is used automatically.
# CHROMIUM_EXECUTABLE_PATH=
