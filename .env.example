# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Local demo/development: questions from ./data + ./Chemistry/mcq, edits in
# ./local-data, no login. Allowed when NODE_ENV is not production.
# On a production server (next start) local mode additionally needs
# ALLOW_LOCAL_DEMO=1, otherwise the app runs in Supabase mode.
# DATA_SOURCE=local
# ALLOW_LOCAL_DEMO=1

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME. Set them on the host BEFORE
# `npm run build`; changing them only at runtime does not update the browser
# bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only: import/upload scripts, /setup and the PDF print-token fallback.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---------------------------------------------------------------------------
# Admin setup (first run only)
# ---------------------------------------------------------------------------
# Required by /setup. The route stops working once an admin exists.
SETUP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# PDF rendering (Node host with Chromium; not serverless)
# ---------------------------------------------------------------------------
# Optional. When unset, the app looks for system Chrome/Edge and then for the
# Playwright browser (npx playwright install chromium --with-deps).
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Optional; defaults to SUPABASE_SERVICE_ROLE_KEY.
# PRINT_TOKEN_SECRET=
